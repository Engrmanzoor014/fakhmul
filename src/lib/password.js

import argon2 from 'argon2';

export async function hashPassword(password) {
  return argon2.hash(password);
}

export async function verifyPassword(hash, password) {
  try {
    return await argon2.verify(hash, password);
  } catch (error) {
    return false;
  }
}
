const users = new Map();

export function createSessionStore() {
  return sessionStore;
}

export function seedProducts() {
  return products;
}

export async function seedAdminUser(appState) {
  const email = env.ADMIN_EMAIL;
  const password = env.ADMIN_PASSWORD;
  const existing = users.get(email);
  if (!existing) {
    users.set(email, {
      id: 'user-admin',
      email,
      passwordHash: await hashPassword(password),
      firstName: 'FAKHMUL',
      lastName: 'Admin',
      role: 'ADMIN',
      isActive: true,
    });
  }
  appState.users = users;
}

export function getSessionFromRequest(req) {
  const token = req.cookies?.sessionId;
  if (!token) return null;
  return sessionStore.get(token) || null;
}

export function createSessionForUser(user) {
  const token = randomUUID();
  sessionStore.set(token, {
    userId: user.id,
    email: user.email,
    role: user.role,
    createdAt: Date.now(),
  });
  return token;
}

export function destroySession(req) {
  const token = req.cookies?.sessionId;
  if (token) sessionStore.delete(token);
}

export function getUserByEmail(email) {
  for (const user of users.values()) {
    if (user.email === email) return user;
  }
  return null;
}

export async function verifyCredentials(email, password) {
  const user = getUserByEmail(email);
  if (!user) return null;
  const isValid = await verifyPassword(user.passwordHash, password);
  if (!isValid) return null;
  return user;
}

export function getProducts() {
  return products.filter((item) => item.isActive);
}

export function getProductById(id) {
  return products.find((item) => item.id === id && item.isActive) || null;
}

export function createProduct(payload) {
  const product = {
    id: `prod-${Date.now()}`,
    ...payload,
    isActive: true,
    createdAt: new Date().toISOString(),
  };
  products.push(product);
  return product;
}

export function updateProductById(id, patch) {
  const product = getProductById(id);
  if (!product) return null;
  Object.assign(product, patch);
  return product;
}

export function getUsers() {
  return [...users.values()];
}
